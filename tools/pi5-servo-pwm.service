[Unit]
Description=Raspberry Pi 5 hardware PWM servo setup
After=systemd-udev-trigger.service
Before=nodered.service node-red.service

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=pi5-servo-pwm
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/node /usr/local/lib/pi5-servo-pwm-setup.cjs setup
ExecStop=/usr/bin/node /usr/local/lib/pi5-servo-pwm-setup.cjs stop

[Install]
WantedBy=multi-user.target
